# Saturnus tunings layered over Valve's SteamOS 3.10.1 kernel config.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_LTO_CLANG_FULL=y
CONFIG_POLLY_CLANG=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3

# Disable the CPU mitigation framework at compile time, as explicitly decided.
# CONFIG_CPU_MITIGATIONS is not set

# LTO: common components built into the kernel.
CONFIG_TLS=y
CONFIG_INPUT_UINPUT=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_SOC=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_RFKILL=y
CONFIG_NTSYNC=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SPI_AMD=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_I2C_CHARDEV=y
CONFIG_SND_AMD_ACP_CONFIG=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_DEV_CCP_DD=y
CONFIG_CRYPTO_DEV_CCP_CRYPTO=y

# LTO: Steam Deck-specific components built into the kernel.
CONFIG_HID_STEAM=y
CONFIG_MFD_STEAMDECK=y
CONFIG_LEDS_STEAMDECK=y
CONFIG_SENSORS_STEAMDECK=y
CONFIG_I2C_PIIX4=y
CONFIG_PERF_EVENTS_INTEL_RAPL=y
CONFIG_IIO=y
CONFIG_LTRF216A=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_POWER_SEQUENCING=y
CONFIG_BT_HCIUART=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_SND_SOC_MAX98388=y
CONFIG_EXTCON_STEAMDECK=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_AMD=y
CONFIG_SND_SOC_NAU8821=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_F2FS_FS=y

# Deliberately left modular: AMDGPU and ath11k Wi-Fi.

# Disable Charcoal-style runtime diagnostic and test instrumentation.
# Keep DEBUG_KERNEL enabled; LAVD's tracing/BTF interfaces are validated below.
CONFIG_PM_DEBUG=n
CONFIG_PM_SLEEP_DEBUG=n
CONFIG_ACPI_DEBUG=n
CONFIG_ACPI_APEI_ERST_DEBUG=n
CONFIG_CEPH_LIB_PRETTYDEBUG=n
CONFIG_AIC94XX_DEBUG=n
CONFIG_SCSI_MVSAS_DEBUG=n
CONFIG_SCSI_DEBUG=n
CONFIG_DM_DEBUG=n
CONFIG_DM_DEBUG_BLOCK_MANAGER_LOCKING=n
CONFIG_MLX4_DEBUG=n
CONFIG_ATH5K_DEBUG=n
CONFIG_ATH6KL_DEBUG=n
CONFIG_ATH10K_DEBUG=n
CONFIG_ATH11K_DEBUG=n
CONFIG_ATH12K_DEBUG=n
CONFIG_ATH5K_TRACER=n
CONFIG_ATH9K_DEBUGFS=n
CONFIG_ATH9K_HTC_DEBUGFS=n
CONFIG_ATH6KL_TRACING=n
CONFIG_ATH10K_TRACING=n
CONFIG_ATH11K_TRACING=n
CONFIG_ATH12K_TRACING=n
CONFIG_B43LEGACY_DEBUG=n
CONFIG_IWLEGACY_DEBUG=n
CONFIG_IWLWIFI_DEBUG=n
CONFIG_RTLWIFI_DEBUG=n
CONFIG_RTW88_DEBUG=n
CONFIG_RTW89_DEBUG=n
CONFIG_SND_DEBUG=n
CONFIG_SND_SOC_SOF_DEBUG_PROBES=n
CONFIG_USB_SERIAL_DEBUG=n
CONFIG_INFINIBAND_MTHCA_DEBUG=n
CONFIG_INFINIBAND_IPOIB_DEBUG=n
CONFIG_VIRTIO_DEBUG=n
CONFIG_NETFS_DEBUG=n
CONFIG_NFS_DEBUG=n
CONFIG_SUNRPC_DEBUG=n
CONFIG_CIFS_DEBUG=n
CONFIG_DLM_DEBUG=n
CONFIG_CRYPTO_DEV_AMLOGIC_GXL_DEBUG=n
CONFIG_SLUB_DEBUG=n
CONFIG_DEBUG_RODATA_TEST=n
CONFIG_DEBUG_SHIRQ=n
CONFIG_SHRINKER_DEBUG=n
CONFIG_IKHEADERS=n
CONFIG_PAGE_POISONING=n
CONFIG_PROFILING=n
CONFIG_SCHEDSTATS=n
CONFIG_FUNCTION_ERROR_INJECTION=n
CONFIG_RUNTIME_TESTING_MENU=n
CONFIG_KALLSYMS_ALL=n
# Kprobes are not used by LAVD. Keep uprobes available so BPF_EVENTS remains
# enabled through its UPROBE_EVENTS dependency after KPROBES is disabled.
CONFIG_KPROBES=n

# sched_ext support for the userspace LAVD scheduler.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_BPF_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_SCHED_CLASS_EXT=y
# Keep kernel tracing/debugfs interfaces available to sched_ext tooling.
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_TRACING=y
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FTRACE_SYSCALLS=y
