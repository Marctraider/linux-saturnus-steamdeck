# Saturnus tunings layered over Valve's SteamOS 3.10.1 kernel config.
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_LTO_CLANG_FULL=y
CONFIG_POLLY_CLANG=y
CONFIG_X86_AMD_PSTATE_DEFAULT_MODE=3

# Disable the CPU mitigation framework at compile time, as explicitly decided.
# CONFIG_CPU_MITIGATIONS is not set

# LTO: common components built into the kernel.
CONFIG_TLS=y
CONFIG_INPUT_UINPUT=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_SOC=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_RFKILL=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SPI_AMD=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_I2C_CHARDEV=y
CONFIG_SND_AMD_ACP_CONFIG=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_DEV_CCP_DD=y
CONFIG_CRYPTO_DEV_CCP_CRYPTO=y

# LTO: Steam Deck-specific components built into the kernel.
CONFIG_HID_STEAM=y
CONFIG_MFD_STEAMDECK=y
CONFIG_LEDS_STEAMDECK=y
CONFIG_SENSORS_STEAMDECK=y
CONFIG_I2C_PIIX4=y
CONFIG_PERF_EVENTS_INTEL_RAPL=y
CONFIG_IIO=y
CONFIG_LTRF216A=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_POWER_SEQUENCING=y
CONFIG_BT_HCIUART=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_SND_SOC_MAX98388=y
CONFIG_EXTCON_STEAMDECK=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_AMD=y
CONFIG_SND_SOC_NAU8821=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_F2FS_FS=y

# Deliberately left modular: AMDGPU and ath11k Wi-Fi.

# sched_ext support for the userspace LAVD scheduler.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
# Keep kernel tracing/debugfs interfaces available to sched_ext tooling.
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_TRACING=y
CONFIG_TRACEFS_FS=y
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FTRACE_SYSCALLS=y
